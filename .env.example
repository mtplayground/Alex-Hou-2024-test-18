# Copy this file to `.env` for local development and adjust values as needed.

# PostgreSQL connection string used by the backend for persistent application state.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todomvc

# Address the backend binds to for HTTP traffic.
BIND_ADDR=0.0.0.0:8080

# Tracing filter passed to tracing-subscriber.
RUST_LOG=backend=info,tower_http=info

# Optional frontend build output directory. Leave unset to disable SPA/static serving.
STATIC_DIR=frontend/dist

# Comma-separated browser origins allowed to call the backend during local frontend development.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
